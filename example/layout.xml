<Layout
    css="/assets/styles.css"
    >
    <Flow direction="row" align="center" wrap="true">
        <Item width="200px" height="200px">
            <Fragment source="main.header"
                group:js="header.js"
                group:css="header.css"
                />
        </Item>
        <Item width="200px" height="200px">
            <Content source="*.md"
                name="navigation"
                bind="true"
                />
        </Item>
        <Item width="200px" height="200px">
                <Fragment source="footer"
                    group:css="footer.css"
                    />
        </Item>
    </Flow>
</Layout>
