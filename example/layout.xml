<Layout
    template="main.tpl"
    css="/assets/styles.css"
    js="/assets/scripts.js"
    >
    <Flow direction="row" align="center" wrap="true">
        <Item width="200px" height="200px">
            <Fragment src="main.header"
                pipeline="header"
                />
        </Item>
        <Item width="200px" height="200px">
            <Content path="*.md"
                pipeline="markdown"
                >
            <Variable name="title" />
            </Content>
        </Item>
        <Item width="200px" height="200px">
                <Fragment src="footer" />
        </Item>
    </Flow>
</Layout>
